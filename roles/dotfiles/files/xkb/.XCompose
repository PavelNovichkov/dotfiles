<Multi_key> <Cyrillic_SOFTSIGN> :    "Ъ"    Cyrillic_HARDSIGN
<Multi_key> <Cyrillic_che> :    "ц"    Cyrillic_tse
<Multi_key> <Cyrillic_CHE> :    "Ц"    Cyrillic_TSE
<Multi_key> <Cyrillic_ie> :    "э"    Cyrillic_e
<Multi_key> <Cyrillic_IE> :    "Э"    Cyrillic_E
<Multi_key> <Cyrillic_sha> :    "щ"    Cyrillic_shcha
<Multi_key> <Cyrillic_SHA> :    "Щ"    Cyrillic_SHCHA
<Multi_key> <Cyrillic_u> :    "ю"    Cyrillic_yu
<Multi_key> <Cyrillic_U> :    "Ю"    Cyrillic_YU

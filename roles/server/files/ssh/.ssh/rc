#!/usr/bin/env bash

# Fix SSH agent forwarding for tmux/screen: point a stable link at the agent of
# the latest interactive login, or of any login if the link is dead.
link="$HOME/.ssh/agent.sock"
if [ -S "$SSH_AUTH_SOCK" ] && [ ! -L "$SSH_AUTH_SOCK" ] \
    && { [ -n "$SSH_TTY" ] || [ ! -S "$link" ]; }; then
    ln -sf "$SSH_AUTH_SOCK" "$link"
fi

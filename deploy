#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: ${0##*/} HOST ROLE [ansible-playbook options...]" >&2
    exit 2
}

[[ $# -ge 2 ]] || usage

target_host="$1"
target_role="$2"
shift 2

exec env SUDO_ASKPASS="$PWD/playbooks/pass.sh" ansible-playbook ./playbooks/deploy.yml -e target_host="$target_host" -e target_role="$target_role" "$@"
